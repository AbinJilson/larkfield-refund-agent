# OpenRouter credentials (secret: set in .env, never commit)
OPENROUTER_API_KEY=
# OpenCode agent key for the Cadra proxy (used by opencode.json via {env:CADRA_API_KEY})
CADRA_API_KEY=

# Models
EXTRACT_MODEL=google/gemini-3.1-flash-lite
DECIDER_MODEL=perplexity/pplx-decider-v1.2
CLASSIFIER=decider            # decider | llm

# Persistence
DATABASE_URL=sqlite:///runs.db
# PostgreSQL alternative (needs a running Postgres server):
# DATABASE_URL=postgresql+psycopg://postgres:<password>@localhost:5432/cadra

# Decision thresholds
TICKET_TYPE_MIN_PROB=0.6
INJECTION_MIN_PROB=0.5

# Model call behaviour
MODEL_TIMEOUT_SECONDS=15
MODEL_MAX_RETRIES=1

# Extract model pricing (USD per million tokens) for cost tracking
EXTRACT_PRICE_INPUT_PER_MTOK=0.25
EXTRACT_PRICE_OUTPUT_PER_MTOK=1.50

# Paths
DATA_ROOM_DIR=data_room
PREPARED_DIR=prepared

# Server
PORT=8000
LOG_LEVEL=INFO

# Eval harness target
EVAL_BASE_URL=http://localhost:8000
