# Keep the image build small and never copy secrets or local state.
.git
.gitignore
.env
.env.*
.venv/
venv/
__pycache__/
**/__pycache__/
*.py[cod]
.pytest_cache/
*.db
runs.db
prepared/
tests/
eval/results/
eval/cases/
*.md
Dockerfile
.dockerignore
fly.toml

# data_room/ is deliberately NOT ignored: the image is built from the local
# checkout and data_room never goes through git.
